(define (batch-offset-bmp pattern)
  (let* ((filenames (cadr (file-glob pattern 1))))
    (for-each (lambda (filename)
                (let* ((image (car (gimp-file-load RUN-NONINTERACTIVE filename filename)))
                       (drawable (car (gimp-image-get-active-layer image)))
                       (new-filename (string-append (substring filename 0 (- (string-length filename) 4)) ".png")))
                  (gimp-item-transform-offset drawable -264 0 1)
                  (gimp-file-save-png RUN-NONINTERACTIVE image drawable new-filename new-filename 0 9 0 0 0 0 0)
                  (gimp-image-delete image)))
              filenames)))